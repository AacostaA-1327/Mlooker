# =============================================================================
# Configuración LOCAL de Mlooker (plantilla para el equipo)
# =============================================================================
# 1. Copia este fichero en la MISMA carpeta con el nombre:
#    application-local.properties
# 2. Sustituye PON_TU_PASSWORD_MYSQL por la contraseña que te pase el responsable.
# 3. Ese fichero NO se sube a Git (.gitignore).
# =============================================================================

spring.jpa.hibernate.ddl-auto=update

spring.datasource.url=jdbc:mysql://localhost:3306/mlooker?createDatabaseIfNotExist=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=PON_TU_PASSWORD_MYSQL

spring.security.user.name=admin
spring.security.user.password=admin
mlooker.security.api-key=dev-api-key
